# Base URL of the village news API (no trailing slash)
# Backend: local `npm run dev` in desa-pendil-backend serves http://localhost:4000/api
API_BASE_URL=http://localhost:4000/api

# Secret for POST /api/revalidate, called by the backend when an admin saves content.
# Use the same random value as REVALIDATE_SECRET in the backend. Empty = the endpoint is off.
REVALIDATE_SECRET=
