# Base URL of the village news API (no trailing slash)
# Local backend (`bun run dev` in desa-pendil-backend): http://localhost:4000/api
API_BASE_URL=http://localhost:4000/api

# Public custom domain serving uploaded media from R2 (no trailing slash)
PUBLIC_MEDIA_PUBLIC_DOMAIN=https://media-dp.raflisahrul.my.id

# Public canonical site URL (used for canonical tags, sitemap.xml, robots.txt, and OG image)
PUBLIC_SITE_URL=https://desapendil.id

# Secret for POST /api/revalidate, called by the backend when an admin saves content.
# Use the same random value as REVALIDATE_SECRET in the backend. Empty = the endpoint is off.
REVALIDATE_SECRET=
